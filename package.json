{
  "name": "atoma-updated",
  "version": "0.0.0",
  "private": true,
  "description": "Local frontend foundation for the third ATOMA storefront pass.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.20.0 <25",
    "pnpm": "11.24.0"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1 --port 3100",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1 --port 3100",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "validate": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "test": "node --experimental-strip-types --test tests/*.test.mjs"
  },
  "dependencies": {
    "@jmm/domain-contracts": "file:vendor/jmm-domain-contracts-0.0.0.tgz",
    "@jmm/shopify-storefront": "file:vendor/jmm-shopify-storefront-0.0.0.tgz",
    "@shopify/checkout-kit": "4.0.0-alpha.4",
    "lenis": "1.3.26",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/three": "0.186.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "prettier": "3.9.6",
    "typescript": "5.9.3"
  }
}
