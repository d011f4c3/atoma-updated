# Server-only Shopify Storefront configuration. Never use NEXT_PUBLIC_ prefixes.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
# Canonical base64 encoding of 32 random bytes. Use a distinct value per environment.
JMM_CART_SESSION_SECRET=
# Optional local test checkout only. Production is always gated (Task 0127).
ATOMA_TEST_CHECKOUT_ENABLED=false
# Isolated local Checkout Kit comparison; requires the test gate above (Task 0130).
ATOMA_CHECKOUT_STUDY_ENABLED=false
# Set only after verifying the exact authorized test-shop checkout host.
SHOPIFY_CHECKOUT_HOST=
