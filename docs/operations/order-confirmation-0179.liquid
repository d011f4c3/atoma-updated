{% comment %} Repository example: replace CONFIGURED-SAMPLE-CREDIT-CODE with the private code configured in Shopify before using this fragment. {% endcomment %}
<style>
    /* ATOMA notification identity — 2026-10-19 */
    body, .body { background: #f6f7f6; color: #20272c; }
    body, td, p { font-family: Arial, Helvetica, sans-serif; }
    p { color: #58636b; font-size: 15px; line-height: 1.65; }
    a, a:hover, a:active, a:visited { color: #263b46; }
    .header { margin: 0; }
    .header__cell { padding: 40px 0 28px; }
    .shop-name__text { margin: 0; }
    .shop-name__text a { color: #20272c; font-family: Arial, Helvetica, sans-serif; font-size: 27px; font-weight: 400; letter-spacing: 1px; text-transform: uppercase; }
    .order-number__text, .po-number__text { color: #69747b; font-family: Menlo, Consolas, monospace; font-size: 12px; letter-spacing: .6px; }
    .content__cell { padding: 8px 0 34px; }
    h2 { color: #20272c; font-size: 26px; font-weight: 400; line-height: 1.35; letter-spacing: -.4px; margin: 0 0 16px; }
    h3 { color: #20272c; font-family: Menlo, Consolas, monospace; font-size: 15px; font-weight: 400; letter-spacing: .7px; text-transform: uppercase; }
    h4 { color: #58636b; font-family: Menlo, Consolas, monospace; font-size: 12px; font-weight: 400; letter-spacing: .4px; text-transform: uppercase; }
    .section__cell { padding: 28px 0; }
    .section, .footer { border-top-color: #d9dfe1; }
    .button__cell, .actions-buttons .button__cell--primary { background: #243640; border: 1px solid #243640; border-radius: 6px; }
    .button__text { text-transform: uppercase; color: #ffffff; font-family: Menlo, Consolas, monospace; font-size: 13px; font-weight: 400; letter-spacing: .4px; padding: 17px 25px; }
    .actions-buttons .button__cell--outlined { border: 1px solid #aeb9bf; border-radius: 6px; background: transparent; }
    .actions-buttons .button__cell--outlined .button__text { color: #243640; }
    .link__cell { font-size: 13px; }
    .order-list__item-title { color: #20272c; font-size: 14px; font-weight: 500; line-height: 1.5; }
    .order-list__item-variant, .order-list__item-property { color: #69747b; font-size: 12px; line-height: 1.6; }
    .order-list__product-image { border-radius: 4px; border-color: #d9dfe1; }
    .order-list__item-price, .subtotal-line__value { color: #20272c; }
    .subtotal-line__title, .subtotal-line__value { font-size: 14px; }
    .subtotal-line--total .subtotal-line__value { font-size: 22px; }
    .customer-info__item-content { font-size: 14px; line-height: 1.6; color: #58636b; }
    .footer__cell { padding: 28px 0 40px; }
    .disclaimer__subtext { color: #69747b; font-size: 12px; line-height: 1.6; }
    @media only screen and (max-width: 600px) {
      .header__cell { padding: 28px 0 22px; }
      h2 { font-size: 23px; }
      .button__text { padding: 17px 18px; }
    }
  </style>

{% comment %} ATOMA sample credit — 2026-10-19 {% endcomment %}
